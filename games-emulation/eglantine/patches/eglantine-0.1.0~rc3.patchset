From 1435697de348c67be10125f4896bca1c8d927c4b Mon Sep 17 00:00:00 2001
From: Techniix <Techniix@users.noreply.github.com>
Date: Mon, 9 Nov 2026 15:49:40 -0500
Subject: [PATCH 1/5] common: use memfd_create for host memory where the build
 finds it

On Haiku, guest memory was backed by a POSIX shared memory object with
a made-up name (shm_open_anon), which can collide and has to be
unlinked again. Renga, a Haiku-based system, has memfd_create() in
libgnu, with its header in Haiku's "gnu" header directory. Look for it
at configure time and use it when it is there; stock Haiku keeps the
shm_open path.

Also close the backing descriptor before forgetting it when falling
back to private mappings: the old code set fd to -1 first and then
closed -1, leaking the descriptor.

Assisted-by: Claude Opus 5.5 (draft; not yet built or run)
---
 src/common/CMakeLists.txt  | 23 +++++++++++++++++++++++
 src/common/host_memory.cpp | 10 +++++++---
 2 files changed, 30 insertions(+), 3 deletions(-)

diff --git a/src/common/CMakeLists.txt b/src/common/CMakeLists.txt
index dcd78ac..70bbac7 100644
--- a/src/common/CMakeLists.txt
+++ b/src/common/CMakeLists.txt
@@ -263,4 +263,27 @@ if(ANDROID)
     target_link_libraries(common PRIVATE android)
 endif()
 
+# Haiku keeps Linux-style interfaces in libgnu, with their headers in a
+# separate "gnu" directory that wraps the POSIX ones (#include_next), so the
+# directory has to come first on the include path. Some Haiku-based systems
+# (Renga) provide memfd_create() there; stock Haiku does not, and keeps using
+# the shm_open() fallback in host_memory.cpp.
+if (HAIKUOS)
+    find_path(HAIKU_GNU_INCLUDE_DIR sys/mman.h
+        PATHS "${CMAKE_SYSROOT}/boot/system/develop/headers/gnu" NO_DEFAULT_PATH)
+    if (HAIKU_GNU_INCLUDE_DIR)
+        include(CheckSymbolExists)
+        set(CMAKE_REQUIRED_INCLUDES "${HAIKU_GNU_INCLUDE_DIR}")
+        set(CMAKE_REQUIRED_LIBRARIES gnu)
+        check_symbol_exists(memfd_create "sys/mman.h" HAVE_MEMFD_CREATE)
+        unset(CMAKE_REQUIRED_INCLUDES)
+        unset(CMAKE_REQUIRED_LIBRARIES)
+        if (HAVE_MEMFD_CREATE)
+            target_include_directories(common BEFORE PRIVATE "${HAIKU_GNU_INCLUDE_DIR}")
+            target_compile_definitions(common PRIVATE HAVE_MEMFD_CREATE)
+            target_link_libraries(common PRIVATE gnu)
+        endif()
+    endif()
+endif()
+
 create_target_directory_groups(common)
diff --git a/src/common/host_memory.cpp b/src/common/host_memory.cpp
index 2ef1982..b60af6a 100644
--- a/src/common/host_memory.cpp
+++ b/src/common/host_memory.cpp
@@ -465,7 +465,8 @@ static void* ChooseVirtualBase(size_t virtual_size) {
 
 #endif
 
-#if defined(__sun__) || defined(__HAIKU__) || defined(__NetBSD__) || defined(__DragonFly__)
+#if (defined(__sun__) || defined(__HAIKU__) || defined(__NetBSD__) || defined(__DragonFly__)) && \
+    !defined(HAVE_MEMFD_CREATE)
 /// Most Unices don't have a portable shm_open (AIX, OpenBSD, NetBSD, Solaris 11, OpenIndiana)
 /// Portable implementation of shm_open(SHM_ANON, ...) - roughly equivalent but without
 /// OS support - may fail sporadically, beware!
@@ -531,7 +532,10 @@ public:
         long page_size = sysconf(_SC_PAGESIZE);
         ASSERT_MSG(page_size == 0x1000, "page size {:#x} is incompatible with 4K paging", page_size);
         // Backing memory initialization
-#if defined(__sun__) || defined(__HAIKU__) || defined(__NetBSD__) || defined(__DragonFly__)
+#if defined(HAVE_MEMFD_CREATE)
+        // Detected at configure time, for systems that are not Linux but have it (Renga)
+        fd = memfd_create("HostMemory", MFD_CLOEXEC);
+#elif defined(__sun__) || defined(__HAIKU__) || defined(__NetBSD__) || defined(__DragonFly__)
         fd = shm_open_anon(O_RDWR | O_CREAT | O_EXCL | O_NOFOLLOW, 0600);
 #elif defined(__OpenBSD__)
         fd = shm_open_anon(O_RDWR | O_CREAT | O_EXCL | O_NOFOLLOW, 0600);
@@ -564,8 +568,8 @@ public:
             LOG_WARNING(Common_Memory, "Using private mappings instead of shared ones");
             backing_base = static_cast<u8*>(mmap(nullptr, backing_size, PROT_READ | PROT_WRITE, MAP_ANONYMOUS | MAP_PRIVATE | MAP_NOCORE, -1, 0));
             if (fd > 0) {
-                fd = -1;
                 close(fd);
+                fd = -1;
             }
         } else {
             backing_base = static_cast<u8*>(mmap(nullptr, backing_size, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_NOCORE, fd, 0));
-- 
2.43.0


From b89a4bc3237808f2b9d7fcb414267ca2475c335a Mon Sep 17 00:00:00 2001
From: Techniix <Techniix@users.noreply.github.com>
Date: Mon, 9 Nov 2026 15:50:17 -0500
Subject: [PATCH 2/5] dynarmic: enable fastmem on Haiku

Haiku was built with the generic exception handler, so every guest
memory access went through the slow path: the build excluded the POSIX
handler because Haiku has no <ucontext.h>. The handler does not need
that header there. Haiku passes a ucontext_t, declared in <signal.h>,
to SA_SIGINFO handlers, and its kernel restores rip and rsp from
uc_mcontext (struct vregs) when the handler returns
(arch_restore_signal_frame), which is all the fastmem fault path uses.

Build the POSIX handler on Haiku and add the register names for
x86_64. This works on stock Haiku as well as on Renga.

Assisted-by: Claude Opus 5.5 (draft; not yet built or run)
---
 src/dynarmic/src/dynarmic/CMakeLists.txt   | 3 +--
 src/dynarmic/src/dynarmic/common/context.h | 9 ++++++++-
 2 files changed, 9 insertions(+), 3 deletions(-)

diff --git a/src/dynarmic/src/dynarmic/CMakeLists.txt b/src/dynarmic/src/dynarmic/CMakeLists.txt
index cc1cbcb..143a0d2 100644
--- a/src/dynarmic/src/dynarmic/CMakeLists.txt
+++ b/src/dynarmic/src/dynarmic/CMakeLists.txt
@@ -363,8 +363,7 @@ elseif (APPLE)
             backend/exception_handler_macos_mig.c
         )
     endif()
-elseif (UNIX AND NOT HAIKUOS)
-    # Haiku lacks <ucontext.h>
+elseif (UNIX)
     if (CMAKE_SYSTEM_NAME STREQUAL "Linux")
         target_link_libraries(dynarmic PRIVATE rt)
     endif()
diff --git a/src/dynarmic/src/dynarmic/common/context.h b/src/dynarmic/src/dynarmic/common/context.h
index 0c18807..e565cfe 100644
--- a/src/dynarmic/src/dynarmic/common/context.h
+++ b/src/dynarmic/src/dynarmic/common/context.h
@@ -8,7 +8,9 @@
 #    include <sys/ucontext.h>
 #else
 #    include <signal.h>
-#    ifndef __OpenBSD__
+// Haiku declares ucontext_t in <signal.h>; <ucontext.h> only exists on newer
+// Haiku-based systems (Renga) and adds nothing the signal handler needs.
+#    if !defined(__OpenBSD__) && !defined(__HAIKU__)
 #        include <ucontext.h>
 #    endif
 #    ifdef __sun__
@@ -131,6 +133,11 @@
 #    elif defined(__managarm__)
 #        define CTX_PC (mctx.__pollution(gregs)[REG_RIP])
 #        define CTX_SP (mctx.__pollution(gregs)[REG_RSP])
+#    elif defined(__HAIKU__)
+// mcontext_t is struct vregs (headers/posix/arch/x86_64/signal.h); the kernel
+// restores rip and rsp from it when the handler returns.
+#        define CTX_PC (mctx.rip)
+#        define CTX_SP (mctx.rsp)
 #    else
 #        error "unknown platform"
 #    endif
-- 
2.43.0


From a00e12070563db07af67d5608056cdc03f37b760 Mon Sep 17 00:00:00 2001
From: Techniix <Techniix@users.noreply.github.com>
Date: Mon, 9 Nov 2026 15:53:35 -0500
Subject: [PATCH 3/5] video_core: present Vulkan on Haiku through the
 VideoStreamsWsi layer

The Haiku Qt platform was mapped to an XCB surface, which no Haiku
Vulkan driver provides. Haiku's hardware Vulkan drivers (NVK from
nvidia-haiku, RADV) present through X547's VideoStreamsWsi, an
implicit layer implementing VK_EXT_headless_surface and
VK_KHR_swapchain; the application gives the surface a bitmap hook and
the layer hands it every presented image as a BBitmap.

Add a Haiku window system type, enable VK_EXT_headless_surface for
it, and create the surface in vulkan_surface_haiku.cpp, which checks
that the layer is loaded before using its surface object and draws
each image into the render window's view. Window locks have a short
timeout so a busy window thread drops a frame instead of stalling the
presenter.

Assisted-by: Claude Opus 5.5 (draft; syntax-checked against Haiku headers, not yet built or run)
---
 src/core/frontend/emu_window.h                |   1 +
