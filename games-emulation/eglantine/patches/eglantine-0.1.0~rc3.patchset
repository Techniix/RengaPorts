From 66ebc2b97c3639d062c2aefccf75e7eef7c7305c Mon Sep 17 00:00:00 2001
From: Techniix <Techniix@users.noreply.github.com>
Date: Mon, 9 Nov 2026 19:39:48 -0500
Subject: [PATCH 5/5] common: detect hole punching and memory hints by feature

Returning guest memory with fallocate(FALLOC_FL_PUNCH_HOLE), and the
MADV_HUGEPAGE and MADV_PAGEOUT hints, were tied to __linux__. Test for
the flags instead, so other systems get them as soon as their headers
define them. Linux builds are unchanged: glibc defines all of them.

On Haiku none of them exist yet and the memset path stays. Renga plans
hole punching on memfds and huge user pages (roadmap F-48); with this
change they switch on without touching the port again.

Assisted-by: Claude Opus 5.5 (draft; not yet built or run)
---
 src/common/host_memory.cpp | 18 +++++++++++++-----
 1 file changed, 13 insertions(+), 5 deletions(-)

diff --git a/src/common/host_memory.cpp b/src/common/host_memory.cpp
index b60af6a..72effb7 100644
--- a/src/common/host_memory.cpp
+++ b/src/common/host_memory.cpp
@@ -36,6 +36,13 @@
 #include <orbis/libkernel.h>
 #endif
 
+// Returning a range of the backing file to the kernel. Detected by its flag
+// rather than the platform; on Haiku-based systems it is planned in Renga's
+// libgnu (roadmap F-48) and switches on here once <fcntl.h> defines it.
+#if defined(FALLOC_FL_PUNCH_HOLE) && defined(FALLOC_FL_KEEP_SIZE)
+#define HOST_MEMORY_PUNCH_HOLE 1
+#endif
+
 // FreeBSD
 #ifndef MAP_NORESERVE
 #define MAP_NORESERVE 0
@@ -520,7 +527,7 @@ public:
         , virtual_size{virtual_size_}
     {}
 
-#ifdef __linux__
+#ifdef HOST_MEMORY_PUNCH_HOLE
     bool PunchHole(size_t offset, size_t length) {
         return fd >= 0 &&
                fallocate(fd, FALLOC_FL_PUNCH_HOLE | FALLOC_FL_KEEP_SIZE, static_cast<off_t>(offset),
@@ -585,7 +592,8 @@ public:
             LOG_CRITICAL(HW_Memory, "mmap failed: {}", strerror(errno));
             return false;
         }
-#if defined(__linux__)
+#if defined(MADV_HUGEPAGE)
+        // Not on Haiku yet: huge user pages are planned in Renga (roadmap F-48)
         madvise(virtual_base, virtual_size, MADV_HUGEPAGE);
 #endif
         free_manager.SetAddressSpace(virtual_base, virtual_size);
@@ -815,7 +823,7 @@ void HostMemory::HintCold(size_t physical_offset, size_t length,
 #ifdef _WIN32
         // Unlocking pages that are not locked takes them out of the working set.
         VirtualUnlock(address, length);
-#elif defined(__linux__) && defined(MADV_PAGEOUT)
+#elif defined(MADV_PAGEOUT)
         madvise(address, length, MADV_PAGEOUT);
 #else
         static_cast<void>(address);
@@ -840,7 +848,7 @@ void HostMemory::ClearBackingRegion(size_t physical_offset, size_t length, u32 f
     // Fresh backing memory is zero and the host gives it no RAM until it's touched: clear only
     // the granules that may hold data (title 1's heap made the host commit every page of it).
     // A granule cleared in full is zero again.
-#ifdef __linux__
+#ifdef HOST_MEMORY_PUNCH_HOLE
     // Handing a whole granule back to the kernel frees its RAM; a memset would commit it.
     static const bool punch = [] {
         const char* value = std::getenv("EDEN_PUNCH_HOLE");
@@ -856,7 +864,7 @@ void HostMemory::ClearBackingRegion(size_t physical_offset, size_t length, u32 f
         if ((granules[index].load(std::memory_order_acquire) & GranuleDirty) != 0) {
             const bool whole = offset == granule_begin && clear_end == granule_end;
             bool cleared = false;
-#ifdef __linux__
+#ifdef HOST_MEMORY_PUNCH_HOLE
             cleared = whole && punch && impl && impl->PunchHole(granule_begin, granule_end - granule_begin);
 #endif
             if (!cleared) {
-- 
