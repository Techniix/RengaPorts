diff --git a/src/video_core/vulkan_common/vulkan_surface_haiku.cpp b/src/video_core/vulkan_common/vulkan_surface_haiku.cpp
new file mode 100644
index 0000000..3bc8643
--- /dev/null
+++ b/src/video_core/vulkan_common/vulkan_surface_haiku.cpp
@@ -0,0 +1,196 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// Vulkan presentation on Haiku.
+//
+// Haiku has no Vulkan surface extension of its own. Its hardware Vulkan
+// drivers (NVK on nvidia-haiku, RADV) present through X547's VideoStreamsWsi,
+// an implicit layer (VK_LAYER_window_system_integration) that implements
+// VK_EXT_headless_surface and VK_KHR_swapchain. The surface it returns is a
+// C++ object; giving it a BitmapHook makes the layer hand every presented
+// image to the hook as a BBitmap, which is drawn into the window here.
+
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+
+#include <Bitmap.h>
+#include <Looper.h>
+#include <Messenger.h>
+#include <View.h>
+#include <Window.h>
+
+#include "common/logging.h"
+#include "video_core/vulkan_common/vulkan_surface_haiku.h"
+
+namespace Vulkan {
+
+namespace {
+
+// Interface of the layer's surface object, as declared in VideoStreamsWsi's
+// Wsi.cpp (MIT). The vtable layout must match the layer's.
+class BitmapHook {
+public:
+    virtual ~BitmapHook() {}
+    virtual void GetSize(uint32_t& width, uint32_t& height) = 0;
+    /// Takes the bitmap and returns the previous one for the layer to delete
+    virtual BBitmap* SetBitmap(BBitmap* bitmap) = 0;
+};
+
+class VKLayerSurfaceBase {
+public:
+    virtual ~VKLayerSurfaceBase() {}
+    virtual void SetBitmapHook(BitmapHook* hook) = 0;
+};
+
+constexpr char WSI_LAYER_NAME[] = "VK_LAYER_window_system_integration";
+
+// The window thread can be busy (resizing, or waiting for the emulator while
+// it shuts down); dropping a frame is better than blocking the presenter.
+constexpr bigtime_t WINDOW_LOCK_TIMEOUT = 20'000;
+
+/// Draws presented images into the first view of a BWindow (the view Qt
+/// draws the render widget with).
+class WindowBitmapHook final : public BitmapHook {
+public:
+    explicit WindowBitmapHook(BWindow* window) : messenger{window} {}
+
+    ~WindowBitmapHook() override {
+        delete bitmap;
+    }
+
+    void GetSize(uint32_t& width, uint32_t& height) override {
+        if (BView* view = LockView()) {
+            const BRect bounds = view->Bounds();
+            last_width = static_cast<uint32_t>(bounds.IntegerWidth() + 1);
+            last_height = static_cast<uint32_t>(bounds.IntegerHeight() + 1);
+            view->Window()->Unlock();
+        }
+        width = last_width;
+        height = last_height;
+    }
+
+    BBitmap* SetBitmap(BBitmap* new_bitmap) override {
+        BBitmap* previous = nullptr;
+        if (new_bitmap != bitmap) {
+            previous = bitmap;
+            bitmap = new_bitmap;
+        }
+        if (bitmap != nullptr) {
+            if (BView* view = LockView()) {
+                view->DrawBitmapAsync(bitmap, bitmap->Bounds(), view->Bounds());
+                view->Flush();
+                view->Window()->Unlock();
+            }
+        }
+        return previous;
+    }
+
+    bool IsValid() const {
+        return messenger.IsValid();
+    }
+
+private:
+    BView* LockView() {
+        if (messenger.LockTargetWithTimeout(WINDOW_LOCK_TIMEOUT) != B_OK) {
+            return nullptr;
+        }
+        BLooper* looper = nullptr;
+        messenger.Target(&looper);
+        auto* window = dynamic_cast<BWindow*>(looper);
+        BView* view = window != nullptr ? window->ChildAt(0) : nullptr;
+        if (view == nullptr && looper != nullptr) {
+            looper->Unlock();
+        }
+        return view;
+    }
+
+    BMessenger messenger;
+    BBitmap* bitmap = nullptr;
+    uint32_t last_width = 1;
+    uint32_t last_height = 1;
+};
+
+// One hook per window, reused for every surface made for that window. A hook
+// must outlive the surfaces it was given to, and the layer does not tell us
+// when it lets go of one, so hooks are kept until their window is gone.
+std::mutex hooks_mutex;
+std::unordered_map<BWindow*, std::unique_ptr<WindowBitmapHook>> hooks;
+
+WindowBitmapHook* HookForWindow(BWindow* window) {
+    std::scoped_lock lock{hooks_mutex};
+    std::erase_if(hooks, [](const auto& entry) { return !entry.second->IsValid(); });
+    auto& hook = hooks[window];
+    if (!hook) {
+        hook = std::make_unique<WindowBitmapHook>(window);
+    }
+    return hook.get();
+}
+
+bool IsWsiLayerActive(const vk::InstanceDispatch& dld) {
+    if (const char* disabled = std::getenv("DISABLE_VIDEOSTREAMS_WSI_LAYER");
+        disabled != nullptr && std::strcmp(disabled, "1") == 0) {
+        return false;
+    }
+    const auto enumerate = reinterpret_cast<PFN_vkEnumerateInstanceLayerProperties>(
+        dld.vkGetInstanceProcAddr(VK_NULL_HANDLE, "vkEnumerateInstanceLayerProperties"));
+    if (enumerate == nullptr) {
+        return false;
+    }
+    uint32_t count = 0;
+    if (enumerate(&count, nullptr) != VK_SUCCESS) {
+        return false;
+    }
+    std::vector<VkLayerProperties> layers(count);
+    if (enumerate(&count, layers.data()) != VK_SUCCESS) {
+        return false;
+    }
+    for (const auto& layer : layers) {
+        if (std::strcmp(layer.layerName, WSI_LAYER_NAME) == 0) {
+            return true;
+        }
+    }
+    return false;
+}
+
+} // Anonymous namespace
+
+VkSurfaceKHR CreateHaikuSurface(VkInstance instance, const vk::InstanceDispatch& dld,
+                                void* window_handle) {
+    auto* window = static_cast<BWindow*>(window_handle);
+    if (window == nullptr) {
+        LOG_ERROR(Render_Vulkan, "No window to present to");
+        return VK_NULL_HANDLE;
+    }
+    // Without the layer the surface is not its object, and SetBitmapHook()
+    // below would call into something else.
+    if (!IsWsiLayerActive(dld)) {
+        LOG_ERROR(Render_Vulkan, "Vulkan presentation on Haiku needs the {} layer "
+                                 "(VideoStreamsWsi, installed with the GPU driver)",
+                  WSI_LAYER_NAME);
+        return VK_NULL_HANDLE;
+    }
+    const auto vkCreateHeadlessSurfaceEXT = reinterpret_cast<PFN_vkCreateHeadlessSurfaceEXT>(
+        dld.vkGetInstanceProcAddr(instance, "vkCreateHeadlessSurfaceEXT"));
+    if (vkCreateHeadlessSurfaceEXT == nullptr) {
+        LOG_ERROR(Render_Vulkan, "vkCreateHeadlessSurfaceEXT is not available");
+        return VK_NULL_HANDLE;
+    }
+    const VkHeadlessSurfaceCreateInfoEXT headless_ci{
+        .sType = VK_STRUCTURE_TYPE_HEADLESS_SURFACE_CREATE_INFO_EXT,
+        .pNext = nullptr,
+        .flags = 0,
+    };
+    VkSurfaceKHR surface = VK_NULL_HANDLE;
+    if (vkCreateHeadlessSurfaceEXT(instance, &headless_ci, nullptr, &surface) != VK_SUCCESS) {
+        LOG_ERROR(Render_Vulkan, "Failed to create the headless surface");
+        return VK_NULL_HANDLE;
+    }
+    reinterpret_cast<VKLayerSurfaceBase*>(surface)->SetBitmapHook(HookForWindow(window));
+    return surface;
+}
+
+} // namespace Vulkan
diff --git a/src/video_core/vulkan_common/vulkan_surface_haiku.h b/src/video_core/vulkan_common/vulkan_surface_haiku.h
new file mode 100644
index 0000000..23ee538
--- /dev/null
+++ b/src/video_core/vulkan_common/vulkan_surface_haiku.h
@@ -0,0 +1,15 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include "video_core/vulkan_common/vulkan_wrapper.h"
+
+namespace Vulkan {
+
+/// Creates a surface presenting into the given BWindow, or VK_NULL_HANDLE.
+[[nodiscard]] VkSurfaceKHR CreateHaikuSurface(VkInstance instance,
+                                              const vk::InstanceDispatch& dld,
+                                              void* window_handle);
+
+} // namespace Vulkan
-- 
2.43.0


From f74290cc3ea8a75020a00c037a100d55c324948c Mon Sep 17 00:00:00 2001
From: Techniix <Techniix@users.noreply.github.com>
Date: Mon, 9 Nov 2026 15:54:26 -0500
Subject: [PATCH 4/5] common: build fixes and Haiku user directories

Link libnetwork by name instead of a fixed path, and fall back to
find_directory() for the data, cache and settings directories when the
XDG variables are not set.

Assisted-by: Claude Opus 5.5 (draft; not yet built or run)
---
 CMakeLists.txt              |  4 ++--
 src/common/fs/path_util.cpp | 21 +++++++++++++++++++++
 2 files changed, 23 insertions(+), 2 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 04d0f17..12db526 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -549,8 +549,8 @@ elseif (WIN32)
 elseif (MANAGARM)
     set(PLATFORM_LIBRARIES iconv intl)
 elseif (HAIKUOS)
-    # Haiku is so special :)
-    set(PLATFORM_LIBRARIES bsd /boot/system/lib/libnetwork.so)
+    # Sockets are in libnetwork, BSD extensions in libbsd
+    set(PLATFORM_LIBRARIES bsd network)
 elseif (CMAKE_SYSTEM_NAME MATCHES "^(Linux|kFreeBSD|GNU|SunOS)$")
     set(PLATFORM_LIBRARIES rt)
 endif()
diff --git a/src/common/fs/path_util.cpp b/src/common/fs/path_util.cpp
index a075dcf..ceee214 100644
--- a/src/common/fs/path_util.cpp
+++ b/src/common/fs/path_util.cpp
@@ -28,6 +28,10 @@
 #include <unistd.h>    // Used in GetDataDirectory()
 #endif
 
+#ifdef __HAIKU__
+#include <FindDirectory.h> // Used in GetDataDirectory()
+#endif
+
 #ifdef __APPLE__
 #include <sys/param.h> // Used in GetBundleDirectory()
 
@@ -381,6 +385,23 @@ fs::path GetDataDirectory(const std::string& env_name) {
         return fs::path{data_env_var};
     }
 
+#ifdef __HAIKU__
+    // Haiku's profile normally sets the XDG variables to these directories
+    // (~/config/non-packaged/data, ~/config/cache, ~/config/settings); use
+    // them too when the program was started without it.
+    directory_which which = B_USER_NONPACKAGED_DATA_DIRECTORY;
+    if (env_name == "XDG_CACHE_HOME") {
+        which = B_USER_CACHE_DIRECTORY;
+    } else if (env_name == "XDG_CONFIG_HOME") {
+        which = B_USER_SETTINGS_DIRECTORY;
+    } else if (env_name != "XDG_DATA_HOME") {
+        return {};
+    }
+    char path[B_PATH_NAME_LENGTH];
+    if (find_directory(which, -1, true, path, sizeof(path)) == B_OK) {
+        return fs::path{path};
+    }
+#endif
     if (env_name == "XDG_DATA_HOME") {
         return GetHomeDirectory() / ".local/share";
     } else if (env_name == "XDG_CACHE_HOME") {
-- 
