 .../vulkan_common/vulkan_surface.cpp          |  19 +-
 .../vulkan_common/vulkan_surface_haiku.cpp    | 196 ++++++++++++++++++
 .../vulkan_common/vulkan_surface_haiku.h      |  15 ++
 8 files changed, 230 insertions(+), 17 deletions(-)
 create mode 100644 src/video_core/vulkan_common/vulkan_surface_haiku.cpp
 create mode 100644 src/video_core/vulkan_common/vulkan_surface_haiku.h

