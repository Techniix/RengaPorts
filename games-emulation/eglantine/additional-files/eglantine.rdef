/*
 * Resources for Eglantine on Haiku and Renga: signature, version and the
 * file types it opens. The vector icon is not here yet (see the port's
 * README.md); Tracker shows the generic application icon until it is.
 */

resource app_signature "application/x-vnd.Eglantine-Emulator";

resource app_flags B_MULTIPLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,

	variety = B_APPV_GAMMA,
	internal = 3,

	short_info = "Eglantine",
	long_info = "Eglantine 0.1.0-rc3, a Nintendo Switch 2 emulator derived from Eden, yuzu and Sudachi"
};

/*
 * The same types as upstream's freedesktop file (dist/dev.eden_emu.eden.xml).
 * Haiku's MIME database does not know them yet, so Tracker only offers
 * Eglantine for these files once the types exist (see README.md).
 */
resource file_types message {
	"types" = "application/x-nx-nro",
	"types" = "application/x-nx-nso",
	"types" = "application/x-nx-nsp",
	"types" = "application/x-nx-xci"
};
