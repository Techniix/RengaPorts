 namespace WebCore {
 
+/*!	Renga: the data source for http(s) media.
+
+	BMediaFile(BUrl) read through the http_streamer's BAdapterIO, which
+	gives up on a read after 10 seconds (B_TIMED_OUT), fails once the
+	request has ended, and cannot seek ahead of the download at all
+	(HTTPMediaIO::SeekRequested() is not implemented). The decoders saw
+	those as errors or as the end of a track: frames came in bursts and
+	MP4 files with their index at the end did not play.
+
+	This source downloads with libcurl (which WebCore already uses for
+	everything else) into an unlinked temporary file and remembers which
+	byte ranges it has. ReadAt() blocks until the bytes asked for are there:
+	it waits when the running request is about to deliver them, and
+	otherwise restarts the request at the first missing byte with an HTTP
+	range ("bytes=N-"). A read returns fewer bytes only at the end of the
+	resource, and an error when the download failed for good (an HTTP
+	4xx, or five failed attempts in a row), when the bytes have not come
+	within kReadDeadline (B_TIMED_OUT, also for a server that only
+	trickles), or when the player went away (Abort(), B_CANCELED) or
+	seeks (SetInterrupted(), B_INTERRUPTED). Servers that ignore ranges
+	(200 to "bytes=0-") are read from the start only.
+*/
+class MediaDataSourceHaiku final : public BPositionIO {
+public:
+    MediaDataSourceHaiku(const CString& url, const CString& userAgent, const CString& referrer)
+        : m_url(url)
+        , m_userAgent(userAgent)
+        , m_referrer(referrer)
+    {
+    }
+
+    ~MediaDataSourceHaiku()
+    {
+        Abort();
+        if (m_thread >= 0) {
+            status_t status;
+            wait_for_thread(m_thread, &status);
+        }
+        if (m_dataSem >= 0)
+            delete_sem(m_dataSem);
+        if (m_requestSem >= 0)
+            delete_sem(m_requestSem);
+        if (m_fd >= 0)
+            close(m_fd);
+    }
+
+    // Starts the download at byte 0 and waits for the response.
+    status_t Open()
+    {
+        char path[B_PATH_NAME_LENGTH];
+        if (find_directory(B_SYSTEM_TEMP_DIRECTORY, -1, false, path, sizeof(path)) != B_OK)
+            strlcpy(path, "/tmp", sizeof(path));
+        strlcat(path, "/webkit-media-XXXXXX", sizeof(path));
+        m_fd = mkstemp(path);
+        if (m_fd < 0)
+            return B_ERROR;
+        // The file goes when it is closed, also after a crash.
+        unlink(path);
+
+        m_dataSem = create_sem(0, "html5 media data");
+        m_requestSem = create_sem(0, "html5 media request");
+        if (m_dataSem < 0 || m_requestSem < 0)
+            return B_NO_MORE_SEMS;
+
+        m_wanted = 0;
+        m_thread = spawn_thread(downloadThread, "media download", B_NORMAL_PRIORITY, this);
+        if (m_thread < 0)
+            return m_thread;
+        resume_thread(m_thread);
+
+        BAutolock locker(m_lock);
+        while (!m_gotResponse && !m_failed && !m_abort)
+            WaitLocked();
+        if (m_abort)
+            return B_CANCELED;
+        return m_gotResponse ? B_OK : B_ERROR;
+    }
+
+    // Wakes every blocked reader with B_CANCELED and stops the download.
+    void Abort()
+    {
+        BAutolock locker(m_lock);
+        m_abort = true;
+        m_generation++;
+        WakeWaiters();
+        if (m_requestSem >= 0)
+            release_sem(m_requestSem);
+    }
+
+    // While set, reads return B_INTERRUPTED at once, blocked ones too: a
+    // seek uses it to get the decoder threads (which read while holding
+    // their decode locks) out of the way. The download goes on.
+    void SetInterrupted(bool interrupted)
+    {
+        BAutolock locker(m_lock);
+        m_interrupted = interrupted;
+        if (interrupted)
+            WakeWaiters();
+    }
+
+    // A read failed for good (the download failed, or a read timed out).
+    bool HasFailed() const
+    {
+        BAutolock locker(m_lock);
+        return m_failed || m_readFailed;
+    }
+
+    ssize_t ReadAt(off_t position, void* buffer, size_t size) final
+    {
+        if (position < 0)
+            return B_BAD_VALUE;
+        if (!size)
+            return 0;
+
+        const bigtime_t deadline = system_time() + kReadDeadline;
+        m_lock.Lock();
+        for (;;) {
+            if (m_abort) {
+                m_lock.Unlock();
+                return B_CANCELED;
+            }
+            if (m_interrupted) {
+                m_lock.Unlock();
+                return B_INTERRUPTED;
+            }
+            if (m_totalSize >= 0) {
+                if (position >= m_totalSize) {
+                    m_lock.Unlock();
+                    return 0;
+                }
+                size = (size_t)std::min<off_t>(size, m_totalSize - position);
+            }
+
+            off_t covered = CoveredFrom(position);
+            if (covered >= (off_t)size)
+                break;
+            // After one read timed out the others do not wait their own
+            // deadline: the player reports the error once, and a seek or
+            // the decoder threads give up at once.
+            if (m_failed || m_readFailed) {
+                m_lock.Unlock();
+                if (covered > 0)
+                    return pread(m_fd, buffer, (size_t)covered, position);
+                return B_IO_ERROR;
+            }
+            bigtime_t now = system_time();
+            if (now >= deadline) {
+                // The old adapter's 10 s, but as an error the player
+                // reports, not as the end of the media.
+                m_readFailed = true;
+                m_lock.Unlock();
+                return B_TIMED_OUT;
+            }
+
+            off_t missing = position + covered;
+            bool coming;
+            if (m_wanted >= 0)
+                coming = missing >= m_wanted && missing - m_wanted <= NearWindow(now);
+            else
+                coming = m_active && missing >= m_cursor && missing - m_cursor <= NearWindow(now);
+            if (!m_rangeSupported)
+                coming = m_active || m_wanted >= 0;
+            // A request runs for at least kMinHold before a reader far
+            // from it moves it, so that two readers far apart (a file
+            // whose tracks are not interleaved) each get data in turn
+            // instead of restarting the transfer on every read.
+            if (!coming && m_active && m_wanted < 0
+                && now - m_requestStartTime < kMinHold)
+                coming = true;
+            if (!coming)
+                RequestFrom(m_rangeSupported ? missing : 0);
+
+            WaitLocked(deadline - now);
+        }
+        m_lock.Unlock();
+
+        // Covered bytes are never changed again, so this needs no lock.
+        return pread(m_fd, buffer, size, position);
+    }
+
+    ssize_t WriteAt(off_t, const void*, size_t) final { return B_NOT_ALLOWED; }
+
+    off_t Seek(off_t position, uint32 seekMode) final
+    {
+        BAutolock locker(m_lock);
+        switch (seekMode) {
+        case SEEK_SET:
+            break;
+        case SEEK_CUR:
+            position += m_position;
+            break;
+        case SEEK_END:
+            if (m_totalSize < 0)
+                return B_NOT_SUPPORTED;
+            position += m_totalSize;
+            break;
+        default:
+            return B_BAD_VALUE;
+        }
+        if (position < 0)
+            return B_BAD_VALUE;
+        m_position = position;
+        return m_position;
+    }
+
+    off_t Position() const final
+    {
+        BAutolock locker(m_lock);
+        return m_position;
+    }
+
+    status_t SetSize(off_t) final { return B_NOT_ALLOWED; }
+
+    status_t GetSize(off_t* size) const final
+    {
+        BAutolock locker(m_lock);
+        if (m_totalSize < 0)
+            return B_NOT_SUPPORTED;
+        *size = m_totalSize;
+        return B_OK;
+    }
+
+private:
+    // A missing byte ahead of the running request is waited for, rather
+    // than fetched with a new request, when the request brings it within
+    // about kNearTime at its rate so far (at least kMinNearWindow, at most
+    // kNearWindow). A fixed 4 MiB window waited 9 s on a 150 KB/s link for
+    // the index at the end of an MP4, close to the read deadline.
+    static constexpr off_t kNearWindow = 4 * 1024 * 1024;
+    static constexpr off_t kMinNearWindow = 64 * 1024;
+    static constexpr bigtime_t kNearTime = 1000000;
+    static constexpr int kMaxFailures = 5;
+    // A read waits at most this long for its bytes.
+    static constexpr bigtime_t kReadDeadline = 10000000;
+    // A request is not moved elsewhere before it ran this long.
+    static constexpr bigtime_t kMinHold = 1000000;
+
+    struct Transfer {
+        MediaDataSourceHaiku* source;
+        uint32 generation;
+        CURL* handle;
+        off_t rangeStart { -1 };
+        off_t rangeTotal { -1 };
+    };
+
+    static status_t downloadThread(void* cookie)
+    {
+        static_cast<MediaDataSourceHaiku*>(cookie)->Download();
+        return B_OK;
+    }
+
+    void Download()
+    {
+        m_lock.Lock();
+        // After a read timed out nothing more is read: stop downloading.
+        while (!m_abort && !m_readFailed) {
+            if (m_wanted < 0) {
+                m_lock.Unlock();
+                acquire_sem_etc(m_requestSem, 1, B_RELATIVE_TIMEOUT, 1000000);
+                m_lock.Lock();
+                continue;
+            }
+
+            off_t start = m_wanted;
+            m_wanted = -1;
+            uint32 generation = ++m_generation;
+            m_requestStart = start;
+            m_requestStartTime = system_time();
+            m_cursor = start;
+            m_active = true;
+            m_gotResponseForRequest = false;
+            m_lock.Unlock();
+
+            long code = 0;
+            CURLcode result = Fetch(start, generation, &code);
+
+            m_lock.Lock();
+            if (m_abort || generation != m_generation) {
+                // Superseded by a request elsewhere (or aborted).
+                continue;
+            }
+            m_active = false;
+
+            if (result == CURLE_OK && !m_gotResponseForRequest && (code == 200 || code == 206)) {
+                // An empty body (complete: a drop before the body is a retry).
+                m_gotResponse = true;
+                if (m_totalSize < 0)
+                    m_totalSize = start;
+            }
+
+            if (code == 416) {
+                // Nothing at or after start: that is the end.
+                m_gotResponse = true;
+                if (m_totalSize < 0)
+                    m_totalSize = start;
+            } else if (result == CURLE_OK && m_gotResponseForRequest) {
+                // An open-ended request that completed ends at the end.
+                if (m_totalSize < 0)
+                    m_totalSize = m_cursor;
+                m_failures = 0;
+            } else if ((code >= 400 && code < 500) || ++m_failures >= kMaxFailures)
+                m_failed = true;
+            else {
+                // Lost connection or a stall: go on where it stopped.
+                m_wanted = m_rangeSupported ? m_cursor : 0;
+                int failures = m_failures;
+                m_lock.Unlock();
+                // Abort() (and a new request) wake this early.
+                acquire_sem_etc(m_requestSem, 1, B_RELATIVE_TIMEOUT, 500000 * failures);
+                m_lock.Lock();
+            }
+            WakeWaiters();
+        }
+        m_active = false;
+        m_lock.Unlock();
+    }
+
+    CURLcode Fetch(off_t start, uint32 generation, long* code)
+    {
+        CURL* handle = curl_easy_init();
+        if (!handle)
+            return CURLE_FAILED_INIT;
+
+        Transfer transfer { this, generation, handle };
+        char range[64];
+        snprintf(range, sizeof(range), "%lld-", (long long)start);
+
+        curl_easy_setopt(handle, CURLOPT_URL, m_url.data());
+        curl_easy_setopt(handle, CURLOPT_RANGE, range);
+        curl_easy_setopt(handle, CURLOPT_FOLLOWLOCATION, 1L);
+        curl_easy_setopt(handle, CURLOPT_MAXREDIRS, 10L);
+#if LIBCURL_VERSION_NUM >= 0x075500
+        curl_easy_setopt(handle, CURLOPT_PROTOCOLS_STR, "http,https");
+        curl_easy_setopt(handle, CURLOPT_REDIR_PROTOCOLS_STR, "http,https");
+#endif
+        curl_easy_setopt(handle, CURLOPT_NOSIGNAL, 1L);
+        curl_easy_setopt(handle, CURLOPT_CONNECTTIMEOUT, 30L);
+        // A stall of 30 s ends the transfer; Download() then resumes it.
+        curl_easy_setopt(handle, CURLOPT_LOW_SPEED_LIMIT, 1L);
+        curl_easy_setopt(handle, CURLOPT_LOW_SPEED_TIME, 30L);
+        if (m_userAgent.length())
+            curl_easy_setopt(handle, CURLOPT_USERAGENT, m_userAgent.data());
+        if (m_referrer.length())
+            curl_easy_setopt(handle, CURLOPT_REFERER, m_referrer.data());
+        curl_easy_setopt(handle, CURLOPT_HEADERFUNCTION, headerCallback);
+        curl_easy_setopt(handle, CURLOPT_HEADERDATA, &transfer);
+        curl_easy_setopt(handle, CURLOPT_WRITEFUNCTION, writeCallback);
+        curl_easy_setopt(handle, CURLOPT_WRITEDATA, &transfer);
+        curl_easy_setopt(handle, CURLOPT_NOPROGRESS, 0L);
+        curl_easy_setopt(handle, CURLOPT_XFERINFOFUNCTION, progressCallback);
+        curl_easy_setopt(handle, CURLOPT_XFERINFODATA, &transfer);
+
+        CURLcode result = curl_easy_perform(handle);
+        curl_easy_getinfo(handle, CURLINFO_RESPONSE_CODE, code);
+        curl_easy_cleanup(handle);
+        return result;
+    }
+
+    static size_t headerCallback(char* data, size_t size, size_t count, void* cookie)
+    {
+        Transfer* transfer = static_cast<Transfer*>(cookie);
+        size_t length = size * count;
+        char line[256];
+        size_t copy = std::min(length, sizeof(line) - 1);
+        memcpy(line, data, copy);
+        line[copy] = '\0';
+
+        if (!strncmp(line, "HTTP/", 5)) {
+            // A new response (after a redirect): forget the last one's.
+            transfer->rangeStart = -1;
+            transfer->rangeTotal = -1;
+        } else if (!strncasecmp(line, "Content-Range:", 14)) {
+            long long first = -1, last = -1, total = -1;
+            int fields = sscanf(line + 14, " bytes %lld-%lld/%lld", &first, &last, &total);
+            if (fields >= 2)
+                transfer->rangeStart = first;
+            if (fields == 3)
+                transfer->rangeTotal = total;
+        }
+        return length;
+    }
+
+    static size_t writeCallback(char* data, size_t size, size_t count, void* cookie)
+    {
+        Transfer* transfer = static_cast<Transfer*>(cookie);
+        return transfer->source->Received(*transfer, data, size * count);
+    }
+
+    static int progressCallback(void* cookie, curl_off_t, curl_off_t, curl_off_t, curl_off_t)
+    {
+        Transfer* transfer = static_cast<Transfer*>(cookie);
+        MediaDataSourceHaiku* source = transfer->source;
+        BAutolock locker(source->m_lock);
+        // Non-zero ends the transfer: superseded, aborted, or a read
+        // timed out.
+        return source->m_abort || source->m_readFailed
+            || transfer->generation != source->m_generation;
+    }
+
+    size_t Received(Transfer& transfer, const char* data, size_t size)
+    {
+        BAutolock locker(m_lock);
+        if (m_abort || transfer.generation != m_generation)
+            return 0;
+
+        if (!m_gotResponseForRequest) {
+            long code = 0;
+            curl_easy_getinfo(transfer.handle, CURLINFO_RESPONSE_CODE, &code);
+            if (code == 206) {
+                if (transfer.rangeStart >= 0)
+                    m_cursor = transfer.rangeStart;
+                if (transfer.rangeTotal >= 0)
+                    m_totalSize = transfer.rangeTotal;
+            } else if (code == 200) {
+                // The server sends the whole resource: no ranges.
+                m_cursor = 0;
+                m_rangeSupported = false;
+                curl_off_t length = -1;
+                if (curl_easy_getinfo(transfer.handle, CURLINFO_CONTENT_LENGTH_DOWNLOAD_T, &length) == CURLE_OK
+                    && length >= 0)
+                    m_totalSize = length;
+            } else {
+                // An error page is not media; Download() sees the code.
+                return 0;
+            }
+            m_gotResponseForRequest = true;
+            m_gotResponse = true;
+            WakeWaiters();
+        }
+
+        size_t done = 0;
+        while (done < size) {
+            ssize_t written = pwrite(m_fd, data + done, size - done, m_cursor + done);
+            if (written <= 0) {
+                m_failed = true;
+                WakeWaiters();
+                return 0;
+            }
+            done += written;
+        }
+        AddRange(m_cursor, m_cursor + size);
+        m_cursor += size;
+        m_failures = 0;
+        WakeWaiters();
+        return size;
+    }
+
+    // How far ahead of the running request a missing byte is waited for;
+    // lock held.
+    off_t NearWindow(bigtime_t now) const
+    {
+        bigtime_t elapsed = now - m_requestStartTime;
+        off_t received = m_cursor - m_requestStart;
+        if (!m_active || elapsed < 250000 || received <= 0)
+            return 4 * kMinNearWindow;
+        off_t window = (off_t)(received * (double)kNearTime / elapsed);
+        return std::clamp(window, kMinNearWindow, kNearWindow);
+    }
+
+    // How many bytes from position on are downloaded; lock held.
+    off_t CoveredFrom(off_t position) const
+    {
+        auto it = m_ranges.upper_bound(position);
+        if (it == m_ranges.begin())
+            return 0;
+        --it;
+        return it->second > position ? it->second - position : 0;
+    }
+
+    // Adds [start, end) to the downloaded ranges, merging; lock held.
+    void AddRange(off_t start, off_t end)
+    {
+        auto it = m_ranges.upper_bound(start);
+        if (it != m_ranges.begin()) {
+            auto previous = std::prev(it);
+            if (previous->second >= start) {
+                start = previous->first;
+                end = std::max(end, previous->second);
+                it = m_ranges.erase(previous);
+            }
+        }
+        while (it != m_ranges.end() && it->first <= end) {
+            end = std::max(end, it->second);
+            it = m_ranges.erase(it);
+        }
+        m_ranges[start] = end;
+    }
+
+    // Restarts the download at start; lock held.
+    void RequestFrom(off_t start)
+    {
+        m_wanted = start;
+        m_generation++;
+        release_sem(m_requestSem);
+    }
+
+    // Waits for news from the download thread (at most 200 ms, or \a limit,
+    // then the caller checks again); lock held, and held again on return.
+    void WaitLocked(bigtime_t limit = 200000)
+    {
+        m_waiters++;
+        m_lock.Unlock();
+        acquire_sem_etc(m_dataSem, 1, B_RELATIVE_TIMEOUT,
+            std::clamp<bigtime_t>(limit, 1000, 200000));
+        m_lock.Lock();
+        m_waiters--;
+    }
+
+    // Lock held.
+    void WakeWaiters()
+    {
+        if (m_waiters <= 0 || m_dataSem < 0)
+            return;
+        int32 count = 0;
+        get_sem_count(m_dataSem, &count);
+        int32 release = m_waiters - std::max<int32>(count, 0);
+        if (release > 0)
+            release_sem_etc(m_dataSem, release, B_DO_NOT_RESCHEDULE);
+    }
+
+    CString m_url;
+    CString m_userAgent;
+    CString m_referrer;
+
+    mutable BLocker m_lock { "html5 media data" };
+    sem_id m_dataSem { -1 };
+    sem_id m_requestSem { -1 };
+    int32 m_waiters { 0 };
+    thread_id m_thread { -1 };
+    int m_fd { -1 };
+
+    std::map<off_t, off_t> m_ranges;
+    off_t m_position { 0 };
+    off_t m_totalSize { -1 };
+    off_t m_wanted { -1 };
+    off_t m_requestStart { -1 };
+    bigtime_t m_requestStartTime { 0 };
+    off_t m_cursor { 0 };
+    uint32 m_generation { 0 };
+    int m_failures { 0 };
+    bool m_active { false };
+    bool m_gotResponse { false };
+    bool m_gotResponseForRequest { false };
+    bool m_rangeSupported { true };
+    bool m_failed { false };
+    bool m_readFailed { false };
+    bool m_interrupted { false };
+    bool m_abort { false };
+};
