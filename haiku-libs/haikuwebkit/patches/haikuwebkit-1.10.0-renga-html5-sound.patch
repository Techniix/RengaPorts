+/*!	Called by IdentifyTracks() with the audio track's decoded format. */
+void MediaPlayerPrivate::SetUpAudio(const media_format& format)
+{
+    const media_raw_audio_format& raw = format.u.raw_audio;
+    m_sampleFormat = raw.format;
+    m_frameSize = (raw.format & 0xf) * raw.channel_count;
+    m_frameRate = raw.frame_rate;
+    // ReadFrames() delivers at most one decoded buffer of the negotiated
+    // size; twice that leaves room should a decoder go over it.
+    m_chunkSize = raw.buffer_size > 0 ? raw.buffer_size : 65536;
+    m_chunk.reset(new (std::nothrow) uint8_t[m_chunkSize * 2]);
+    // Half a second of sound, and at least four decoded buffers.
+    size_t ringSize = m_frameSize * (size_t)(m_frameRate / 2);
+    ringSize = std::max(ringSize, m_chunkSize * 4);
+    if (m_frameSize > 0)
+        ringSize -= ringSize % m_frameSize;
+    m_ring.reset(new (std::nothrow) uint8_t[ringSize]);
+    m_ringSize = m_ring && m_chunk && m_frameSize > 0 ? ringSize : 0;
+    if (!m_ringSize)
+        m_ring.reset();
+    m_ringWritten = 0;
+    m_ringRead = 0;
+    m_framesPlayed = 0;
+    m_audioStartTime = 0;
+    m_audioEOF = false;
+    m_endReported = false;
+
+    if (m_ringSize) {
+        m_audioThread = spawn_thread(audioThread, "audio decoder",
+            B_URGENT_DISPLAY_PRIORITY, this);
+        if (m_audioThread >= 0)
+            resume_thread(m_audioThread);
+    }
+}
