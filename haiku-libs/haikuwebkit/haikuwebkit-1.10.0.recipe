# Renga build of HaikuWebKit 1.10.0: the HaikuPorts recipe (master,
# revision 2) with three Renga patches (roadmap F-57, batches 8 and 14).
#
# haikuwebkit-1.10.0-renga-html5-sound.patch, HTML5 <audio>/<video> sound
# (MediaPlayerPrivateHaiku). Found with media_html5_test in the Renga
# harness using the packaged 1.10.0 binary: WebM sound with gaps (about
# 90 % of 10 ms blocks silent), MP4 sound missing, while the Media Kit part
# of the same path plays both cleanly. Causes in 1.10.0's player:
# - the sound player's real-time callback locked m_mediaLock, which the
#   video thread held while decoding a frame (tens of ms on a slow or
#   emulated CPU), so the callback missed its deadline;
# - the callback decoded one chunk with ReadFrames() whatever the buffer's
#   size: a larger buffer kept old data in its tail, a smaller one was
#   overrun.
# Now audio is decoded by an "audio decoder" thread into a half-second
# ring; the callback only copies exactly its buffer's size out of it (a
# short ring lock, never held while decoding) and plays silence for
# what is not decoded yet; the clock is the audio actually played. Each
# track has its own decode lock; video frames are decoded into a second
# bitmap and swapped in under a frame lock, which paint() takes. After
# the sound ends, the video goes on with the system clock. Also:
# duration() is the longer track (a video without an audio track had
# none), seekToTarget() stops both decoders, restarts the ring at the
# audio track's new position, and returns its promise (it returned
# nothing: undefined behaviour).
# Replaces haikuwebkit-1.10.0-renga-video-only.patch (revision 100, never
# built), which was written against haikuwebkit's "haiku" branch and does
# not apply to the 1.10.0 tarball (one hunk fails); 1.10.0 already runs a
# video without audio on the system clock, and its duration fix is in the
# new patch.
#
# haikuwebkit-1.10.0-renga-user-agent.patch: Version/26.0 (Safari 26)
# instead of 17.0 in the user agent, nothing else changed.
#
# Status (2026-11-20): Implemented, not tested. Both patches apply to the
# 1.10.0 tarball; MediaPlayerPrivateHaiku.cpp compiles with Renga's
# x86_64-unknown-haiku cross-compiler (GCC 13.3) against Renga's
# haiku_devel and HaikuPorts' devel packages on the Linux build host. The
# whole engine was not built there: WebCore alone is about 690 unified
# objects, several hours on the 2-core host. Build with HaikuPorter on
# Renga, then check with media_html5_test (renga-raw) and a page with a
# WebM and an MP4 clip.
#
# haikuwebkit-1.10.0-renga-media-sync.patch (revision 102, batch 14):
# 1.10.0-101 on hardware: sound fine, video choppy and too fast.
# - Data source: http(s) media is read through MediaDataSourceHaiku, a
#   BPositionIO that downloads with libcurl into an unlinked temporary file
#   and keeps a map of the byte ranges it has. ReadAt() blocks until the
#   range asked for is there: it waits when the running request is at most
#   4 MiB short of it, and otherwise restarts the request at the first
#   missing byte ("Range: bytes=N-"). Short reads only at the end of the
#   resource; errors only after an HTTP 4xx, five failed attempts in a row,
#   or cancelLoad() (Abort(), B_CANCELED). BMediaFile(BUrl) through the
#   http_streamer gave up after 10 s and could not seek ahead of the
#   download. Other URLs, and http(s) that the source cannot open, still
#   go through BMediaFile(BUrl).
# - Video: each frame is presented by its PTS (media_header.start_time)
#   against the audio clock (the buffer the sound player last took,
#   interpolated, minus BSoundPlayer::Latency()). Early frames wait, a
#   frame whose successor is already due is dropped (at least one frame
#   every 250 ms is still shown), a seek drops the held frame, and repaint
#   requests are coalesced. -101 showed every frame as soon as it was
#   decoded and caught up after each stall at full decode speed.
# - Video PTS: counted from the last seek (BMediaTrack::SeekToTime()'s
#   time plus one frame duration per frame), not media_header.start_time,
#   which the FFmpeg plug-in gives for video in the stream's time base
#   (frame numbers in a 1/24 MP4, milliseconds in a WebM): read as
#   microseconds, every frame was late and dropped, the decoder ran to the
#   end within seconds and the last frame stayed on screen. Assumes a
#   constant frame rate.
# - End: the time runs on to duration() after the last frame and the end
#   is reported (it stood just short of it, and "ended" never came).
# - Seeking: the whole duration is seekable when MediaDataSourceHaiku reads
#   the media (1.10.0 clamped every seek to at most the current time).
# Status (2026-11-28): built natively in the Renga build VM (HaikuPorter);
# QEMU Tested with WebPositive: an H.264+AAC MP4 and a VP9+Opus WebM play
# with the picture in step with currentTime, continuous sound, forward
# and backward seeks, and "ended" at the end.
SUMMARY="Open source web browser engine"
DESCRIPTION="
WebKit is an open source web browser engine. WebKit is also the name of the \
Mac OS X system framework version of the engine that's used by Safari, \
Dashboard, Mail, and many other OS X applications. WebKit's HTML and \
JavaScript code began as a branch of the KHTML and KJS libraries from KDE."
HOMEPAGE="https://www.webkit.org/"
COPYRIGHT="1998-2026 Apple Inc., Google Inc., Sony, Samsung, Igalia, et al"
LICENSE="GNU LGPL v2
	GNU LGPL v2.1
	MIT"
REVISION="102"
# Revisions from 100 up for Renga builds of HaikuPorts packages (README).

SOURCE_URI="https://codeberg.org/haiku/haikuwebkit/releases/download/HaikuWebKit-$portVersion/haikuwebkit-$portVersion.tar.gz"
CHECKSUM_SHA256="5852128e3cba2b411e1a006a9c54cca74b96ca51fd9435c3cbb9b732d02fc556"
SOURCE_DIR="haikuwebkit"
PATCHES="
	haikuwebkit-$portVersion-renga-html5-sound.patch
	haikuwebkit-$portVersion-renga-user-agent.patch
	haikuwebkit-$portVersion-renga-media-sync.patch
	"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="?x86"

PROVIDES="
	haikuwebkit$secondaryArchSuffix = $portVersion
	cmd:jsc
	lib:libJavaScriptCore$secondaryArchSuffix = $portVersion compat >= 1
	lib:libWebKitLegacy$secondaryArchSuffix = $portVersion
	"
REQUIRES="
	haiku$secondaryArchSuffix
	lib:libatomic$secondaryArchSuffix
	lib:libavif$secondaryArchSuffix
	lib:libcurl$secondaryArchSuffix
	lib:libexecinfo$secondaryArchSuffix
	lib:libgl$secondaryArchSuffix
	lib:libicuuc$secondaryArchSuffix >= 74
	lib:libgpg_error$secondaryArchSuffix
	lib:libjpeg$secondaryArchSuffix
	lib:liblcms2$secondaryArchSuffix
	lib:libpng16$secondaryArchSuffix
	lib:libpsl$secondaryArchSuffix
	lib:libsqlite3$secondaryArchSuffix
	lib:libssl$secondaryArchSuffix
	lib:libwebp$secondaryArchSuffix
	lib:libwoff2dec$secondaryArchSuffix
	lib:libxml2$secondaryArchSuffix
	lib:libxslt$secondaryArchSuffix
	lib:libz$secondaryArchSuffix
	"

PROVIDES_devel="
	haikuwebkit${secondaryArchSuffix}_devel = $portVersion
	devel:libJavaScriptCore$secondaryArchSuffix = $portVersion
	devel:libWebKitLegacy$secondaryArchSuffix = $portVersion
	"
REQUIRES_devel="
	haikuwebkit$secondaryArchSuffix == $portVersion base
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	gcc${secondaryArchSuffix}_syslibs
	gcc${secondaryArchSuffix}_syslibs_devel
	devel:libavif$secondaryArchSuffix >= 16
	devel:libcurl$secondaryArchSuffix
	devel:libexecinfo$secondaryArchSuffix
	devel:libgl$secondaryArchSuffix
	devel:libicuuc$secondaryArchSuffix >= 74
	devel:libjpeg$secondaryArchSuffix
	devel:liblcms2$secondaryArchSuffix
	devel:libpng16$secondaryArchSuffix
	devel:libpsl$secondaryArchSuffix
	devel:libsqlite3$secondaryArchSuffix
	devel:libssl$secondaryArchSuffix >= 3
	devel:libwebp$secondaryArchSuffix >= 7
	devel:libwoff2dec$secondaryArchSuffix
	devel:libxml2$secondaryArchSuffix
	devel:libxslt$secondaryArchSuffix
	devel:libz$secondaryArchSuffix
	"

# Note: llvm_ar is the command needed from llvm, not llvm_config, but only llvm_config
# has a version constraint in current llvm packages.
BUILD_PREREQUIRES="
	cmd:bison
	cmd:cmake
	cmd:flex
	cmd:gcc$secondaryArchSuffix
	cmd:gperf
	cmd:llvm_config >= 21
	cmd:m4
	cmd:make
	cmd:ninja
	cmd:perl
	cmd:pkg_config
	cmd:python3
	cmd:ruby
	cmd:which
	"

BUILD()
{
	export DISABLE_ASLR=1
	export PKG_CONFIG_LIBDIR="`finddir B_SYSTEM_DIRECTORY`/$relativeDevelopLibDir/pkgconfig"
	Tools/Scripts/build-webkit --haiku --no-webkit2 --no-fatal-warnings --makeargs "$jobArgs" \
		--cmakeargs="-DCMAKE_INSTALL_PREFIX=$prefix -DCMAKE_BUILD_TYPE=Release -DSHOULD_INSTALL_JS_SHELL=ON -DCMAKE_CXX_FLAGS='-ftrack-macro-expansion=0 --param ggc-min-expand=10'"
}

INSTALL()
{
	cd WebKitBuild/Release
	ninja $jobArgs install

	prepareInstalledDevelLibs libWebKitLegacy libJavaScriptCore

	# devel package
	packageEntries devel \
		$developDir
}
