       free(hgl_dpy);
       disp->DriverData = NULL;
-      return _eglError(EGL_NOT_INITIALIZED, "eglInitialize: no Zink screen");
+      return _eglError(EGL_NOT_INITIALIZED, "eglInitialize: no Gallium screen");
    }
    hgl_dpy->disp = hgl_create_display(screen);
 
